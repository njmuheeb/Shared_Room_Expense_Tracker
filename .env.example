# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored; this example file is safe to commit.

# ---------------------------------------------------------------------------
# Public by design. Vite inlines every VITE_* variable into the browser bundle.
# The anon key is meant to be public. Access is controlled by Row Level Security
# policies in supabase/migrations/, not by hiding this key.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Never prefix these with VITE_ and never import them from
# anything under src/. The service_role key bypasses Row Level Security.
# Only uncomment this if you run the Supabase CLI for migrations.
# ---------------------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_SERVICE_ROLE_KEY=
